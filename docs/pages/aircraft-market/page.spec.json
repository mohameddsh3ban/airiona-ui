        {
          "id": "listing",
          "component": "StayCard",
          "each": "aircraft",
          "bind": {
            "title": "item.title",
            "price": "item.price",
            "unit": "item.unit",
            "description": "item.description",
            "tags": "item.tags",
            "image": "item.image",
            "photos": "item.photos",
            "saved": "item.saved"
          },
          "inputs": {
            "cta": "View details"
          },
          "events": {
            "reserve": "openListing"
          },
          "show": {
            "base": false,
            "md": true
          },
          "why": "A tall photo card with title, three-line description, two tags and a price with one action: the system card for a priced listing",
          "alternatives": [
            {
              "component": "DestinationCard",
              "rejected": "rating and Book now, for places"
            },
            {
              "component": "MiniDestination",
              "rejected": "too small for a listing that costs millions"
            }
          ],
          "notes": "Routes to the detail page; the heart saves to the watchlist"
        },
        {
          "id": "listingPhone",
          "component": "MiniDestination",
          "each": "aircraft",
          "show": {
            "md": false
          },
          "bind": {
            "title": "item.title",
            "image": "item.image",
            "price": "item.price",
            "duration": "item.base",
            "dates": "item.facts",
            "badge": "item.tags[0]"
          },
          "events": {
            "press": "openListing"
          },
          "why": "On phones a listing is a compact photo card with the name, price, base and three facts, the app feed pattern; the tall StayCard returns from tablets up",
          "alternatives": [
            {
              "component": "StayCard",
              "rejected": "about 550px tall at 390px wide: one listing per screen"
            }
          ]
        }
      ]
