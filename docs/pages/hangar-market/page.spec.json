          "id": "listingPhone",
          "component": "MiniDestination",
          "each": "hangars",
          "show": {
            "md": false
          },
          "bind": {
            "title": "item.title",
            "image": "item.image",
            "price": "item.price",
            "duration": "item.base",
            "dates": "item.facts",
            "badge": "item.tags[0]"
          },
          "events": {
            "press": "openListing"
          },
          "why": "On phones a listing is a compact photo card with the name, price, base and three facts, the app feed pattern; the tall StayCard returns from tablets up",
          "alternatives": [
            {
              "component": "StayCard",
              "rejected": "about 550px tall at 390px wide: one listing per screen"
