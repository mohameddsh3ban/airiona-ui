        }
      ],
      "states": {
        "loading": "Select shows 'Searching airports…'",
        "empty": "Select empty text: 'No airport matches that. Try the city or the IATA code.'",
        "error": "Select hint: 'Airports could not load. Type the IATA code.'"
      }
    },
    {
      "name": "aircraftCards",
      "type": "AircraftCard[]",
      "source": "GET /api/charter/offers?from&to&date&pax (aircraft that can fly the route that day, all-in prices)",
      "sample": [
        {
          "value": "o-light",
          "title": "Phenom 300E",
          "meta": "6 seats · 8 h 20 m",
          "price": "$32,900",
          "note": "all-in",
          "image": "assets/photos/aviation/jet-light.webp",
          "badge": "1 stop · ATH"
        },
        {
          "value": "o-mid",
          "title": "Citation Latitude",
          "meta": "9 seats · 7 h 25 m",
          "price": "$48,400",
          "note": "all-in",
          "image": "assets/photos/aviation/jet-midsize.webp",
          "badge": "Best value"
        },
        {
          "value": "o-heavy",
          "title": "Global 6500",
          "meta": "14 seats · 7 h 10 m",
          "price": "$86,500",
          "note": "all-in",
          "image": "assets/photos/aviation/jet-heavy.webp"
        }
      ],
      "states": {
        "empty": "No aircraft can fly this route on that date. Try the day before or after, or a nearby airport.",
        "loading": "Three OptionList row skeletons",
        "error": "Inline error with Retry; the trip form stays filled"
      }
    },
    {
      "name": "quote",
      "type": "Quote",
      "source": "POST /api/charter/quote { offerId, passengers } (recomputed when the aircraft or passengers change)",
      "sample": {
        "from": {
          "code": "DXB",
          "city": "Dubai"
        },
        "to": {
          "code": "LTN",
          "city": "London"
        },
        "summary": "Thu, 15 Oct · 4 passengers",
        "priceLines": [
          {
            "label": "Flight, Citation Latitude",
            "value": "$44,200"
          },
          {
            "label": "Airport and handling fees",
            "value": "$2,650"
          },
          {
            "label": "Catering for 4",
            "value": "$560"
          },
          {
            "label": "VAT",
            "value": "$990"
          },
          {
            "label": "Total (USD)",
            "value": "$48,400"
          }
        ],
        "total": "$48,400"
      },
      "states": {
        "loading": "Price lines show Skeleton rows; the request button stays disabled",
        "error": "Toast 'We could not price this trip' with Retry"
      }
    }
  ],
  "sections": [
    {
      "id": "nav",
      "title": "Site navigation",
      "heading": false,
      "purpose": "Desktop navigation",
      "layout": {
        "base": "stack"
      },
      "show": {
        "base": false,
        "lg": true
      },
      "area": {
        "lg": "full"
      },
      "elements": [
        {
          "id": "topNav",
          "component": "TopNav",
          "inputs": {
            "links": [
              {
                "value": "book",
                "label": "Book"
              },
              {
                "value": "trips",
                "label": "My trips"
              },
              {
                "value": "aircraft",
                "label": "Aircraft"
              },
              {
                "value": "hangars",
                "label": "Hangars"
              }
            ],
            "value": "book",
            "user": {
              "name": "Omar Saleh",
              "email": "omar@example.com"
            }
          },
          "why": "The product's four destinations with the signed-in client",
          "children": [
            {
              "id": "navHelp",
              "component": "Button",
              "slot": "arActions",
              "text": "Talk to a broker",
              "inputs": {
                "variant": "secondary",
                "size": "sm",
                "iconStart": "phone"
              },
              "why": "Charter clients expect a human; replaces TopNav's default search and bell"
            }
          ]
        }
      ]
    },
    {
      "id": "topbar",
      "title": "Book a flight",
      "heading": false,
      "purpose": "Phone title and broker shortcut",
      "layout": {
        "base": "stack"
      },
      "show": {
        "lg": false
      },
      "elements": [
        {
          "id": "appBar",
          "component": "AppBar",
          "inputs": {
            "title": "Book a flight",
            "large": true,
            "eyebrow": "Private charter",
            "accent": true
          },
          "why": "Root screen of the Book tab: large title (the page h1 on phones and tablets)",
          "children": [
            {
              "id": "callBroker",
              "component": "IconButton",
              "slot": "arActions",
              "inputs": {
                "icon": "phone",
                "label": "Talk to a broker",
                "variant": "surface"
              },
              "why": "One-tap call to a broker"
            }
          ]
        }
      ]
    },
    {
      "id": "route",
      "title": "Your route",
      "heading": false,
      "purpose": "The A to B the whole page is about, shown as the route arc",
      "layout": {
        "base": "stack"
      },
      "bleed": {
        "base": true
      },
      "area": {
        "lg": "full"
      },
      "elements": [
        {
          "id": "routeHeader",
          "component": "RouteHeader",
          "bind": {
            "from": "quote.from",
            "to": "quote.to",
            "meta": "quote.summary"
          },
          "inputs": {
            "title": "Dubai to London",
            "image": "assets/art/route-globe.webp"
          },
          "why": "The system's route header: both airports, the arc between them and the trip line; it makes the A to B the hero",
          "alternatives": [
            {
              "component": "HeroHeader",
              "rejected": "no route; a generic headline panel"
            }
          ]
        }
      ]
    },
    {
      "id": "trip",
      "title": "Trip",
      "heading": false,
      "purpose": "Where, when and how many: changing any of it refreshes the offers",
      "layout": {
        "base": "stack",
        "md": "grid-2",
        "lg": "grid-4"
      },
      "form": "booking",
      "elements": [
        {
          "id": "desktopTitle",
          "component": "html",
          "tag": "h1",
          "class": "m-large-title",
          "text": "Book a flight",
          "show": {
            "base": false,
            "lg": true
          },
          "span": {
            "md": "full"
          }
        },
        {
          "id": "tripType",
          "component": "MobileSegmented",
          "field": "tripType",
          "inputs": {
            "tone": "brand",
            "options": [
              {
                "value": "one",
                "label": "One way"
              },
              {
                "value": "return",
                "label": "Return"
              }
            ]
          },
          "show": {
            "lg": false
          },
          "span": {
            "md": "full"
          },
          "why": "Two always-visible options with a thumb-sized switch on phones"
        },
        {
          "id": "tripTypeDesktop",
          "component": "SegmentedControl",
          "field": "tripType",
          "inputs": {
            "tone": "brand",
            "options": [
              {
                "value": "one",
                "label": "One way"
              },
              {
                "value": "return",
                "label": "Return"
              }
            ]
          },
          "show": {
            "base": false,
            "lg": true
          },
          "span": {
            "lg": "full"
          },
          "why": "Compact pill group above the trip row on desktop; same form control"
        },
        {
          "id": "from",
          "component": "Select",
          "field": "from",
          "bind": {
            "options": "airports"
          },
          "inputs": {
            "searchable": true,
            "searchPlaceholder": "City or airport code",
            "iconStart": "map-pin",
            "emptyText": "No airport matches that."
          },
          "why": "One airport from many; searchable by city or IATA code"
        },
        {
          "id": "to",
          "component": "Select",
          "field": "to",
          "bind": {
            "options": "airports"
          },
          "inputs": {
            "searchable": true,
            "searchPlaceholder": "City or airport code",
            "iconStart": "map-pin",
            "emptyText": "No airport matches that."
          },
          "why": "Same control as From so the pair reads as one route"
        },
        {
          "id": "departure",
          "component": "DatePicker",
          "field": "departure",
          "inputs": {
            "mode": "single",
            "min": "2026-10-04",
            "presets": [
              {
                "label": "Tomorrow",
                "value": "2026-10-04"
              },
              {
                "label": "This Friday",
                "value": "2026-10-09"
              }
            ]
          },
          "why": "One departure date with quick presets; a charter can leave any day",
          "alternatives": [
            {
              "component": "Calendar",
              "rejected": "an inline month takes the phone screen"
            }
          ]
        },
        {
          "id": "passengers",
          "component": "QuantityStepper",
          "field": "passengers",
          "inputs": {
            "description": "Adults and children",
            "min": 1,
            "max": 19
          },
          "why": "A bounded count; the maximum is the largest cabin offered"
        }
      ]
    },
    {
      "id": "offers",
      "title": "Choose your aircraft",
      "purpose": "Aircraft that can fly this route on that date, with all-in prices: the choice itself",
      "layout": {
        "base": "stack"
      },
      "intro": "Prices are for the whole aircraft and include crew, fuel, airport fees and VAT.",
      "form": "booking",
      "elements": [
        {
          "id": "aircraft",
          "component": "OptionList",
          "field": "aircraft",
          "bind": {
            "options": "aircraftCards"
          },
          "why": "One selectable row per aircraft with its photo, category, route facts and all-in price: the native way to choose (like picking a ride), one column on phones and three on desktop. It is the form field itself, so there is no separate dropdown",
          "alternatives": [
            {
              "component": "FlightTicket + Select",
              "rejected": "the old pairing: tall tickets broke the phone layout and the choice lived in a separate dropdown"
            },
            {
              "component": "MobileSegmented",
              "rejected": "three aircraft need photos and prices, not short labels"
            }
          ]
        }
      ]
    },
    {
      "id": "passenger",
      "title": "Lead passenger",
      "purpose": "Who flies and how the operator reaches them",
      "layout": {
        "base": "stack",
        "md": "grid-2"
      },
      "form": "booking",
      "elements": [
        {
          "id": "fullName",
          "component": "TextField",
          "field": "fullName",
          "inputs": {
            "iconStart": "user"
          },
          "span": {
            "md": "full"
          },
          "why": "Name as on the passport, for the manifest"
        },
        {
          "id": "email",
          "component": "TextField",
          "field": "email",
          "inputs": {
            "iconStart": "envelope",
            "hint": "Confirmation and invoice go here"
          },
          "why": "Email keyboard and autofill"
        },
        {
          "id": "phone",
          "component": "TextField",
          "field": "phone",
          "inputs": {
            "iconStart": "phone",
            "hint": "The crew may call before departure"
          },
          "why": "Phone keyboard and autofill"
        },
        {
          "id": "requests",
          "component": "TextField",
          "field": "requests",
          "inputs": {
            "placeholder": "Catering, pets, ground transport"
          },
          "span": {
            "md": "full"
          },
          "why": "Free text for the operator; optional"
        },
        {
          "id": "terms",
          "component": "Checkbox",
          "field": "terms",
          "span": {
            "md": "full"
          },
          "why": "Explicit agreement to the charter terms (requiredTrue)"
        }
      ]
    },
    {
      "id": "summary",
      "title": "Trip summary",
      "purpose": "What the request costs; beside the form on desktop",
      "layout": {
        "base": "stack"
      },
      "area": {
        "lg": "aside"
      },
      "elements": [
        {
          "id": "flightFacts",
          "component": "InfoStatRow",
          "inputs": {
            "items": [
              {
                "icon": "clock",
                "label": "7 h 25 m"
              },
              {
                "icon": "users",
                "label": "4 of 9 seats"
              },
              {
                "icon": "briefcase",
                "label": "10 bags"
              }
            ]
          },
          "why": "The three numbers clients ask first"
        },
        {
          "id": "priceLines",
          "component": "DetailList",
          "bind": {
            "items": "quote.priceLines"
          },
          "why": "Label and value rows for the all-in price, total last"
        },
        {
          "id": "hold",
          "component": "Badge",
          "inputs": {
            "tone": "warning",
            "icon": "clock"
          },
          "text": "Price held for 15 minutes",
          "why": "Charter prices move; the hold explains the urgency without pressure"
        }
      ]
    },
    {
      "id": "request",
      "title": "Request",
      "heading": false,
      "purpose": "The total and the request button, always in reach on phones",
      "layout": {
        "base": "stack"
      },
      "form": "booking",
      "sticky": {
        "base": "bottom",
        "lg": "none"
      },
      "elements": [
        {
          "id": "requestBar",
          "component": "StickyActionBar",
          "why": "The system's bottom CTA: price summary plus one 60px button",
          "children": [
            {
              "id": "requestTotal",
              "component": "html",
              "tag": "strong",
              "slot": "arSummary",
              "class": "m-title-2",
              "text": "$48,400"
            },
            {
              "id": "requestAircraft",
              "component": "html",
              "tag": "span",
              "slot": "arSummary",
              "class": "m-footnote pg-muted",
              "text": "Citation Latitude · 4 passengers"
            },
            {
              "id": "requestButton",
              "component": "Button",
              "submit": true,
              "text": "Request flight",
              "inputs": {
                "variant": "primary",
                "size": "lg",
                "iconEnd": "paper-airplane"
              },
              "why": "The one primary action; the operator confirms within the hold"
            }
          ]
        }
      ]
    }
  ],
  "forms": [
    {
      "id": "booking",
      "submit": {
        "label": "Request flight",
        "action": "POST /api/charter/requests { offerId, tripType, from, to, departure, passengers, leadPassenger, requests }",
        "success": {
          "kind": "burst",
          "title": "You're flying to London",
          "text": "Request AR-58213 · Thu, 15 Oct · DXB to LTN · the operator confirms within 15 minutes",
          "dialogTitle": "Request sent",
          "action": "View trip"
        },
        "failure": "Offer no longer available (410): Toast 'That aircraft was just booked' and the offers refresh; any other error: danger Toast with Retry and the form kept"
      },
      "fields": [
        {
          "name": "tripType",
          "label": "Trip type",
          "component": [
            "MobileSegmented",
            "SegmentedControl"
          ],
          "default": "one",
          "validators": [
            {
              "type": "required"
            }
          ],
          "messages": {
            "required": "Choose one way or return."
          }
        },
        {
          "name": "from",
          "label": "From",
          "component": "Select",
          "default": "DXB",
          "validators": [
            {
              "type": "required"
            }
          ],
          "messages": {
            "required": "Choose where you fly from."
          }
        },
        {
          "name": "to",
          "label": "To",
          "component": "Select",
          "default": "LTN",
          "validators": [
            {
              "type": "required"
            }
          ],
          "messages": {
            "required": "Choose where you fly to."
          }
        },
        {
          "name": "departure",
          "label": "Departure",
          "component": "DatePicker",
          "default": "2026-10-15",
          "validators": [
            {
              "type": "required"
            },
            {
              "type": "futureDate"
            }
          ],
          "messages": {
            "required": "Choose a departure date.",
            "futureDate": "Departure can't be in the past."
          }
        },
        {
          "name": "passengers",
          "label": "Passengers",
          "component": "QuantityStepper",
          "default": 4,
          "validators": [
            {
              "type": "min",
              "value": 1
            },
            {
              "type": "max",
              "value": 19
            }
          ],
          "messages": {
            "min": "At least one passenger flies.",
            "max": "For more than 19 passengers, talk to a broker."
          }
        },
        {
          "name": "aircraft",
          "label": "Aircraft",
          "component": "OptionList",
          "default": null,
          "inputs": {},
          "validators": [
            {
              "type": "required"
            }
          ],
          "messages": {
            "required": "Choose the aircraft you want."
          }
        },
        {
          "name": "fullName",
          "label": "Full name",
          "component": "TextField",
          "default": "",
          "inputs": {
            "autocomplete": "name"
          },
          "validators": [
            {
              "type": "required"
            },
            {
              "type": "minLength",
              "value": 3
            },
            {
              "type": "maxLength",
              "value": 80
            }
          ],
          "messages": {
            "required": "Enter the lead passenger's name as on the passport.",
            "minlength": "Enter the full name.",
            "maxlength": "Use at most 80 characters."
          }
        },
        {
          "name": "email",
          "label": "Email",
          "component": "TextField",
          "default": "",
          "inputs": {
            "type": "email",
            "autocomplete": "email",
            "inputMode": "email"
          },
          "validators": [
            {
              "type": "required"
            },
            {
              "type": "email"
            }
          ],
          "messages": {
            "required": "Enter an email for the confirmation.",
            "email": "Enter an email like name@example.com."
          }
        },
        {
          "name": "phone",
          "label": "Mobile phone",
          "component": "TextField",
          "default": "",
          "inputs": {
            "type": "tel",
            "autocomplete": "tel",
            "inputMode": "tel"
          },
          "validators": [
            {
              "type": "required"
            },
            {
              "type": "phone"
            }
          ],
          "messages": {
            "required": "Enter a phone number the crew can reach.",
            "phone": "Enter a phone number with country code, like +971 50 123 4567."
          }
        },
        {
          "name": "requests",
          "label": "Requests",
          "component": "TextField",
          "default": "",
          "inputs": {
            "autocomplete": "off"
          },
          "validators": [
            {
              "type": "maxLength",
              "value": 500
            }
          ],
          "messages": {
            "maxlength": "Keep requests under 500 characters."
          }
        },
        {
          "name": "terms",
          "label": "I agree to the charter terms and the cancellation policy",
          "component": "Checkbox",
          "default": false,
          "validators": [
            {
              "type": "requiredTrue"
            }
          ],
          "messages": {
            "required": "Tick to agree before requesting."
          }
        }
      ]
    }
  ],
  "motion": [
    {
      "where": "Arriving from search or the home page",
      "component": "RouteTransition",
      "variant": "fade-through",
      "why": "Top-level destination"
    },
    {
      "where": "Offers after the trip changes",
      "component": "Skeleton",
      "why": "Offers load in place without the layout jumping"
    },
    {
      "where": "After the request is sent",
      "component": "SuccessBurst",
      "why": "The one celebration at the end of the booking"
    }
  ],
  "a11y": [
    "One h1: AppBar large title on phones and tablets, the visible 'Book a flight' heading on desktop.",
    "The offer carousel on phones is a scrollable region; each card names the aircraft, operator and price in text.",
    "Submit moves focus to the first invalid field; the success dialog takes focus and returns it to the request button when closed."
  ],
  "gaps": [],
  "notes": [
    "Phone order: title, route, trip details, aircraft offers (swipe), the aircraft choice, lead passenger, price summary, sticky request bar. Desktop: route full width, then the form on the left and the price summary sticky on the right.",
    "Return trips add a return date field and a second leg on each offer; the sample shows one way.",
    "The request bar total follows the selected aircraft (quote.total); the sample shows the midsize offer.",
    "No card entry here: charter is confirmed by the operator first, then paid by invoice or card link.",
    "Choose your aircraft is one OptionList: each row is an offer with its photo, category, stops, duration, seats and the all-in price; selecting a row is the form value (required). The tickets and the separate dropdown are gone."
  ]
}
