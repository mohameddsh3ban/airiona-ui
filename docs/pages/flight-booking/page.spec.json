          "label": "Dubai International",
          "meta": "DXB"
        },
        {
          "value": "DWC",
          "label": "Dubai Al Maktoum",
          "meta": "DWC"
        },
        {
          "value": "LTN",
          "label": "London Luton",
          "meta": "LTN"
        },
        {
          "value": "FAB",
          "label": "Farnborough",
          "meta": "FAB"
        },
        {
          "value": "NCE",
          "label": "Nice Côte d'Azur",
          "meta": "NCE"
        },
        {
          "value": "GVA",
          "label": "Geneva",
          "meta": "GVA"
        },
        {
          "value": "RUH",
          "label": "Riyadh King Khalid",
