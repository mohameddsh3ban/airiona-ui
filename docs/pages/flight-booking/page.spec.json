{
  "page": "flight-booking",
  "title": "Book a flight",
  "route": "book",
  "target": "angular",
  "source": {
    "kind": "brief",
    "ref": "",
    "notes": "The central page of the product: a client books a private flight from A to B. One page carries the whole booking: route, trip details, aircraft offers for that route, the chosen aircraft, the lead passenger and the request. Prices are quoted per aircraft for the whole flight; the booking is a request the operator confirms, paid by invoice or card after confirmation (no card entry on this page)."
  },
  "audience": "A client (often an assistant booking for someone) on a phone or laptop, who knows the route and date and wants the right aircraft at a clear all-in price",
  "primaryAction": "Request the flight on the chosen aircraft",
  "types": {
    "Airport": {
      "value": "string",
      "label": "string",
      "meta": "string"
    },
    "Endpoint": {
      "code": "string",
      "city": "string",
      "time": "string"
    },
    "Fact": {
      "label": "string",
      "value": "string"
    },
    "Offer": {
      "id": "string",
      "aircraft": "string",
      "category": "string",
      "operator": "string",
      "image": "string",
      "from": "Endpoint",
      "to": "Endpoint",
      "duration": "string",
      "details": "Fact[]"
    },
    "AircraftOption": {
      "value": "string",
      "label": "string",
      "description": "string",
      "meta": "string"
    },
    "RouteEnd": {
      "code": "string",
      "city": "string"
    },
    "Quote": {
      "from": "RouteEnd",
      "to": "RouteEnd",
      "summary": "string",
      "priceLines": "Fact[]",
      "total": "string"
    },
    "AircraftCard": {
      "value": "string",
      "title": "string",
      "meta": "string",
      "price": "string",
      "note": "string",
      "image": "string",
      "badge": "string?"
    }
  },
  "data": [
    {
      "name": "airports",
      "type": "Airport[]",
      "source": "GET /api/airports?query= (searchable, nearest first)",
      "sample": [
