  ],
  "motion": [
    {
      "where": "Arriving from the listing card",
      "component": "RouteTransition",
      "variant": "shared-axis-x",
      "why": "Forward navigation from the list; back returns along the same axis"
    }
  ],
  "a11y": [
    "One h1: \"Gulfstream G550\", visually hidden because the PlaceHero plate shows the name; sections use h2.",
    "The photo has alt text describing what it shows; the PlaceHero photo is named by the listing title.",
    "The sticky bar submits the contact form; on an empty submit focus moves to the first invalid field.",
    "The intent switch is a labelled group of three options; arrow keys move between them."
  ],
  "gaps": [],
  "notes": [
    "Records are behind buyer verification; the form only starts the conversation.",
    "The second photo is the cabin; the gallery (5 photos) opens from the PlaceHero in the product app."
  ],
  "forms": [
    {
      "id": "enquiry",
      "submit": {
        "label": "Contact seller",
        "action": "POST /api/aircraft/g550/enquiries { fullName, email, phone, intent, message, financing }",
        "success": {
          "kind": "burst",
          "dialogTitle": "Message sent",
          "title": "The broker has your message",
          "text": "Expect a reply within one business day. We emailed you a copy.",
          "action": "Done"
        },
        "failure": "Network or 5xx: danger Toast with Retry, the form stays filled; 429: Toast asking to wait a minute"
      },
      "fields": [
        {
          "name": "fullName",
          "label": "Full name",
          "component": "TextField",
          "default": "",
          "inputs": {
            "autocomplete": "name",
            "iconStart": "user"
          },
          "validators": [
            {
              "type": "required"
            },
            {
              "type": "maxLength",
              "value": 80
            }
          ],
          "messages": {
            "required": "Enter your name.",
            "maxlength": "Names are at most 80 characters."
          }
        },
        {
          "name": "email",
          "label": "Email",
          "component": "TextField",
          "default": "",
          "inputs": {
            "type": "email",
            "autocomplete": "email",
            "inputMode": "email",
            "iconStart": "envelope"
          },
          "validators": [
            {
              "type": "required"
            },
            {
              "type": "email"
            }
          ],
          "messages": {
            "required": "Enter your email.",
            "email": "Enter an email like name@example.com."
          }
        },
        {
          "name": "phone",
          "label": "Phone",
          "component": "TextField",
          "default": "",
          "inputs": {
            "type": "tel",
            "autocomplete": "tel",
            "inputMode": "tel",
            "iconStart": "phone"
          },
          "validators": [
            {
              "type": "required"
            },
            {
              "type": "phone"
            }
          ],
          "messages": {
            "required": "Enter a phone number.",
            "phone": "Enter a number with its country code, like +971 50 123 4567."
          }
        },
        {
          "name": "intent",
          "label": "I want to",
          "component": "MobileSegmented",
          "default": "buy",
          "inputs": {
            "label": "I want to",
            "tone": "brand",
            "options": [
              {
                "value": "buy",
                "label": "Buy"
              },
              {
                "value": "lease",
                "label": "Lease"
              },
              {
                "value": "charter",
                "label": "Charter"
              }
            ]
          },
          "validators": [
            {
              "type": "required"
            }
          ],
          "messages": {
            "required": "Choose what you want to do."
          }
        },
        {
          "name": "message",
          "label": "Message (optional)",
          "component": "TextField",
          "default": "",
          "inputs": {
            "placeholder": "Ask about records, delivery or a viewing",
            "autocomplete": "off"
          },
          "validators": [
            {
              "type": "maxLength",
              "value": 500
            }
          ],
          "messages": {
            "maxlength": "Keep it under 500 characters."
          }
        },
        {
          "name": "financing",
          "label": "I would like financing options",
          "component": "Checkbox",
          "default": false,
          "validators": [],
          "messages": {}
        }
      ]
    }
  ]
}
