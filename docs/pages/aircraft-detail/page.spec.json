    {
      "id": "hero",
      "title": "Gulfstream G550",
      "heading": false,
      "purpose": "The listing photo with the name, base and price",
      "layout": {
        "base": "stack"
      },
      "bleed": {
        "base": true,
        "md": false
      },
      "elements": [
        {
          "id": "pageTitle",
          "component": "html",
          "tag": "h1",
          "class": "pg-sr-only",
          "text": "Gulfstream G550"
        },
        {
          "id": "placeHero",
          "component": "PlaceHero",
          "inputs": {
            "title": "Gulfstream G550",
            "location": "Dubai World Central · DWC",
            "price": "$24.5M",
            "priceLabel": "Asking price",
            "image": "assets/photos/aviation/jet-heavy.webp"
          },
          "events": {
            "back": "goBack"
          },
          "why": "Full-width photo with glass back and bookmark buttons and a plate with the name, place and price: the system detail header",
          "alternatives": [
            {
              "component": "LandingHero",
              "rejected": "a page-opening marketing hero, not a listing photo"
            }
          ]
        }
      ]
    },
    {
      "id": "facts",
      "title": "Key facts",
      "heading": false,
      "purpose": "The four numbers buyers check first",
      "layout": {
        "base": "stack"
      },
      "elements": [
        {
          "id": "factRow",
          "component": "InfoStatRow",
          "inputs": {
            "items": [
              {
                "icon": "clock",
                "label": "4,210 hrs"
              },
              {
                "icon": "user-group",
                "label": "16 seats"
              },
              {
                "icon": "calendar",
                "label": "2016"
              },
              {
                "icon": "globe-alt",
                "label": "6,750 nm"
              }
            ]
          },
          "why": "Icon and short label in one row, scannable at a glance"
        }
      ]
    },
    {
      "id": "about",
      "title": "About",
      "heading": true,
      "purpose": "The seller description, clamped on phones",
      "layout": {
        "base": "stack"
      },
      "elements": [
        {
          "id": "aboutText",
          "component": "ExpandableText",
          "inputs": {
            "lines": 4
          },
          "text": "One owner since new and flown by a corporate flight department on a Part 91 programme. The 72-month inspection was completed at Gulfstream Savannah in March 2026, with new brakes, a fresh battery and updated navigation databases. The cabin was refurbished in 2023: sixteen seats in three zones, six of them berthable, a forward galley and an aft lavatory with shower. All logbooks and records are digital and available to verified buyers on request; the aircraft has no damage history.",
          "why": "Long seller copy clamped to four lines with Read more"
        }
      ]
    },
    {
      "id": "specs",
      "title": "Specification",
      "heading": true,
      "purpose": "Every figure a buyer or broker compares",
      "layout": {
        "base": "stack",
        "md": "grid-2"
      },
      "elements": [
        {
          "id": "specList",
          "component": "DetailList",
          "inputs": {
            "items": [
              {
                "label": "Serial number",
                "value": "5530"
              },
