              },
              {
                "label": "Total time",
                "value": "4,210 hours"
              },
              {
                "label": "Landings",
                "value": "1,870"
              },
              {
                "label": "Engines",
                "value": "2 × Rolls-Royce BR710 C4-11"
              },
              {
                "label": "Engine programme",
                "value": "CorporateCare Enhanced"
              },
              {
                "label": "Avionics",
                "value": "Honeywell PlaneView, EVS II"
              },
              {
                "label": "Last inspection",
                "value": "72-month, Mar 2026"
              }
            ]
          },
          "why": "Label and value rows, the system way to list facts"
        },
        {
          "id": "photo",
          "component": "html",
          "tag": "figure",
          "class": "pg-figure",
          "children": [
            {
              "id": "photoImg",
              "component": "html",
              "tag": "img",
              "class": "pg-photo",
              "src": "assets/photos/aviation/jet-cabin.webp",
              "alt": "The G550 cabin: cream leather club seats, walnut tables and oval windows"
            },
            {
              "id": "photoCaption",
              "component": "html",
              "tag": "figcaption",
              "class": "pg-muted m-footnote",
