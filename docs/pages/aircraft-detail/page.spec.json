      ]
    },
    {
      "id": "contact",
      "title": "Contact the seller",
      "heading": true,
      "intro": "The broker replies within one business day. Records are shared after a short verification.",
      "purpose": "Reach the seller or host; beside the details on desktop",
      "layout": {
        "base": "stack",
        "md": "grid-2",
        "lg": "stack"
      },
      "area": {
        "lg": "aside"
      },
      "form": "enquiry",
      "elements": [
        {
          "id": "fullName",
          "component": "TextField",
          "field": "fullName",
          "why": "Who is asking"
        },
        {
          "id": "email",
          "component": "TextField",
          "field": "email",
          "why": "Where the records link goes"
        },
        {
          "id": "phone",
          "component": "TextField",
          "field": "phone",
          "why": "Brokers call serious buyers"
        },
        {
          "id": "intent",
          "component": "MobileSegmented",
          "field": "intent",
          "why": "Buy, lease or charter changes who answers",
          "span": {
            "md": 2
          }
        },
        {
          "id": "message",
          "component": "TextField",
          "field": "message",
          "span": {
            "md": 2
          },
          "why": "Optional question for the seller"
        },
        {
          "id": "financing",
          "component": "Checkbox",
          "field": "financing",
          "span": {
            "md": 2
          },
          "why": "Optional; routes the lead to a financing partner as well"
        },
        {
          "id": "desktopSubmit",
          "component": "Button",
          "submit": true,
          "text": "Contact seller",
          "inputs": {
            "variant": "primary",
            "size": "lg",
            "block": true,
            "iconEnd": "arrow-right"
          },
          "show": {
            "base": false,
            "lg": true
          },
          "why": "At 1280 the form sits in the side column with its own button; the sticky bar is a phone and tablet pattern"
        }
