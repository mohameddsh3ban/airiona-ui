  "target": "angular",
  "source": {
    "kind": "brief",
    "ref": "product brief: Airiona aircraft and hangar marketplaces",
    "notes": "The detail page behind one aircraft listing card: photo, key facts, description, specification, amenities and a contact form that stays in reach on phones."
  },
  "audience": "A buyer, broker or flight department checking one aircraft in detail on a phone, deciding whether to ask for records.",
  "primaryAction": "Contact the seller",
  "types": {},
  "data": [],
  "sections": [
