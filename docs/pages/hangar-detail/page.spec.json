              },
              {
                "icon": "bolt",
                "label": "Ground power"
              },
              {
                "icon": "shield-check",
                "label": "24/7 security"
              },
              {
                "icon": "wrench-screwdriver",
                "label": "Line maintenance"
              },
              {
                "icon": "truck",
                "label": "Towing included"
              },
              {
                "icon": "sparkles",
                "label": "Weekly wash"
              }
            ]
          },
          "why": "Icon tiles summing up the facilities, 4–6 items"
        }
      ]
    },
    {
      "id": "reviews",
      "title": "What tenants say",
      "heading": true,
      "purpose": "Trust from people who parked here",
      "layout": {
        "base": "stack"
      },
      "elements": [
        {
          "id": "rating",
          "component": "RatingBreakdown",
          "inputs": {
            "score": "4.8",
            "scoreLabel": "42 tenant reviews",
            "segments": [
              {
                "label": "Excellent",
                "value": 81
              },
              {
                "label": "Good",
                "value": 14
              },
              {
                "label": "Average",
                "value": 4
              },
              {
                "label": "Poor",
                "value": 1
              }
            ],
            "note": "Tenants rate security and towing highest.",
            "title": "Tenant rating"
          },
          "why": "Score with a split bar: one figure and how it breaks down"
        }
      ]
    },
    {
      "id": "contact",
      "title": "Request space",
      "heading": true,
      "intro": "The host confirms availability within a day. Nothing is charged until they do.",
      "purpose": "Reach the seller or host; beside the details on desktop",
      "layout": {
        "base": "stack",
        "md": "grid-2",
        "lg": "stack"
      },
      "area": {
        "lg": "aside"
      },
      "form": "lease",
      "elements": [
        {
          "id": "aircraftSize",
          "component": "Select",
          "field": "aircraftSize",
          "why": "Size decides whether it fits and the price"
        },
        {
          "id": "registration",
          "component": "TextField",
          "field": "registration",
          "why": "The host checks the aircraft against the door and insurance"
        },
        {
          "id": "leaseDates",
          "component": "DatePicker",
          "field": "leaseDates",
          "span": {
            "md": 2
          },
          "why": "Move-in and move-out as two tiles in one range picker"
        },
        {
          "id": "fullName",
          "component": "TextField",
          "field": "fullName",
          "why": "Who is asking"
        },
        {
          "id": "email",
          "component": "TextField",
          "field": "email",
          "why": "Where the confirmation goes"
        },
        {
          "id": "phone",
          "component": "TextField",
          "field": "phone",
          "span": {
            "md": 2
          },
          "why": "Hosts call to arrange the first tow-in"
        },
        {
          "id": "desktopSubmit",
          "component": "Button",
          "submit": true,
          "text": "Request space",
          "inputs": {
            "variant": "primary",
            "size": "lg",
            "block": true,
            "iconEnd": "arrow-right"
          },
          "show": {
            "base": false,
            "lg": true
          },
          "why": "At 1280 the form sits in the side column with its own button; the sticky bar is a phone and tablet pattern"
        }
      ]
    },
    {
      "id": "cta",
      "title": "Send",
      "heading": false,
      "purpose": "Price and the one action, always in reach on phones",
      "layout": {
        "base": "stack"
      },
      "form": "lease",
      "sticky": {
        "base": "bottom"
      },
      "show": {
        "lg": false
      },
      "elements": [
        {
          "id": "ctaBar",
          "component": "StickyActionBar",
          "why": "The system's bottom CTA: price summary plus one button",
          "children": [
            {
              "id": "ctaTotal",
              "component": "html",
              "tag": "strong",
              "class": "m-title-2",
              "text": "$2,400 / mo",
              "slot": "arSummary"
            },
            {
              "id": "ctaNote",
              "component": "html",
              "tag": "span",
              "class": "m-footnote pg-muted",
              "text": "Towing and security included",
              "slot": "arSummary"
            },
            {
              "id": "ctaButton",
              "component": "Button",
              "submit": true,
              "text": "Request space",
              "inputs": {
                "variant": "primary",
                "size": "lg",
                "iconEnd": "arrow-right"
              },
              "why": "The one primary action"
            }
          ]
        }
      ]
    }
  ],
  "motion": [
    {
      "where": "Arriving from the listing card",
      "component": "RouteTransition",
      "variant": "shared-axis-x",
      "why": "Forward navigation from the list; back returns along the same axis"
    }
  ],
  "a11y": [
    "One h1: \"Hangar 4, Dubai South\", visually hidden because the PlaceHero plate shows the name; sections use h2.",
    "The photo has alt text describing what it shows; the PlaceHero photo is named by the listing title.",
    "The sticky bar submits the contact form; on an empty submit focus moves to the first invalid field.",
    "The date range announces the selected nights in words; dateRange and futureDate errors are read out."
  ],
  "gaps": [],
  "notes": [
    "Fit is checked server side from the registration (type, wingspan, tail height); the Select is for the price estimate.",
    "Monthly pricing; nightly stays are on FBO hangars only."
  ],
  "forms": [
    {
      "id": "lease",
      "submit": {
        "label": "Request space",
        "action": "POST /api/hangars/dwc-4/requests { aircraftSize, registration, leaseDates, fullName, email, phone }",
        "success": {
          "kind": "burst",
          "dialogTitle": "Request sent",
          "title": "Space requested",
          "text": "Hangar 4 · Dubai South · the host confirms within one day.",
          "action": "Done"
        },
        "failure": "409 (dates taken): message under the dates 'Those dates were just booked. Pick another range.'; network: danger Toast with Retry"
      },
      "fields": [
        {
          "name": "aircraftSize",
          "label": "Aircraft size",
          "component": "Select",
          "default": null,
          "inputs": {
            "placeholder": "Choose a size",
            "iconStart": "paper-airplane",
            "options": [
              {
                "value": "heli",
                "label": "Helicopter"
              },
              {
                "value": "light",
                "label": "Light jet"
              },
              {
                "value": "midsize",
                "label": "Midsize or super-midsize jet"
              },
              {
                "value": "heavy",
                "label": "Heavy or ultra-long-range jet"
              }
            ]
          },
          "validators": [
            {
              "type": "required"
            }
          ],
          "messages": {
            "required": "Choose your aircraft size."
          }
        },
        {
          "name": "registration",
          "label": "Registration",
          "component": "TextField",
          "default": "",
          "inputs": {
            "placeholder": "A6-ARN",
            "autocomplete": "off",
            "iconStart": "identification"
          },
          "validators": [
            {
              "type": "required"
            },
            {
              "type": "pattern",
              "value": "^[A-Za-z0-9]{1,2}-?[A-Za-z0-9]{2,5}$"
            }
          ],
          "messages": {
            "required": "Enter the registration.",
            "pattern": "Enter a registration like A6-ARN or N550GA."
          }
        },
        {
          "name": "leaseDates",
          "label": "Dates",
          "component": "DatePicker",
          "default": null,
          "inputs": {
            "label": "Dates",
            "mode": "range",
            "variant": "tiles",
            "startLabel": "Move in",
            "endLabel": "Move out",
            "min": "2026-10-03",
            "today": "2026-10-03",
            "unit": "night"
          },
          "validators": [
            {
              "type": "required"
            },
            {
              "type": "dateRange"
            },
            {
              "type": "futureDate"
            }
          ],
          "messages": {
            "required": "Choose your dates.",
            "dateRange": "Choose a move-out date after move-in.",
            "futureDate": "Dates must be in the future."
          }
        },
        {
          "name": "fullName",
          "label": "Full name",
          "component": "TextField",
          "default": "",
          "inputs": {
            "autocomplete": "name",
            "iconStart": "user"
          },
          "validators": [
            {
              "type": "required"
            },
            {
              "type": "maxLength",
              "value": 80
            }
          ],
          "messages": {
            "required": "Enter your name.",
            "maxlength": "Names are at most 80 characters."
          }
        },
        {
          "name": "email",
          "label": "Email",
          "component": "TextField",
          "default": "",
          "inputs": {
            "type": "email",
            "autocomplete": "email",
            "inputMode": "email",
            "iconStart": "envelope"
          },
          "validators": [
            {
              "type": "required"
            },
            {
              "type": "email"
            }
          ],
          "messages": {
            "required": "Enter your email.",
            "email": "Enter an email like name@example.com."
          }
        },
        {
          "name": "phone",
          "label": "Phone",
          "component": "TextField",
          "default": "",
          "inputs": {
            "type": "tel",
            "autocomplete": "tel",
            "inputMode": "tel",
            "iconStart": "phone"
          },
          "validators": [
            {
              "type": "required"
            },
            {
              "type": "phone"
            }
          ],
          "messages": {
            "required": "Enter a phone number.",
            "phone": "Enter a number with its country code, like +971 50 123 4567."
          }
        }
      ]
    }
  ]
}
