          "inputs": {
            "links": [
              {
                "value": "book",
                "label": "Book"
              },
              {
                "value": "trips",
                "label": "My trips"
              },
              {
                "value": "aircraft",
                "label": "Aircraft"
              },
              {
                "value": "hangars",
                "label": "Hangars"
              }
            ],
            "value": "hangars",
            "user": {
              "name": "Omar Saleh",
              "email": "omar@example.com"
            }
          },
          "why": "The product's four destinations with the signed-in account; replaces the phone tab bar at 1280",
          "children": [
            {
              "id": "navAction",
              "component": "Button",
              "slot": "arActions",
              "text": "List your hangar",
              "inputs": {
                "variant": "secondary",
                "size": "sm",
                "iconStart": "plus"
              },
              "events": {
                "click": "listHangar"
              },
              "why": "The host door stays in the header"
            }
          ]
        }
      ]
    },
    {
      "id": "hero",
      "title": "Hangar 4, Dubai South",
      "heading": false,
      "purpose": "The listing photo with the name, base and price",
      "layout": {
        "base": "stack"
      },
      "bleed": {
        "base": true,
        "md": false
      },
      "elements": [
        {
          "id": "pageTitle",
          "component": "html",
          "tag": "h1",
          "class": "pg-sr-only",
          "text": "Hangar 4, Dubai South"
        },
        {
          "id": "placeHero",
          "component": "PlaceHero",
          "inputs": {
            "title": "Hangar 4, Dubai South",
            "location": "Dubai World Central · DWC",
            "price": "$2,400",
            "priceLabel": "Per month",
            "image": "assets/photos/aviation/hangar-large.webp"
          },
          "events": {
            "back": "goBack"
          },
          "why": "Full-width photo with glass back and bookmark buttons and a plate with the name, place and price: the system detail header",
          "alternatives": [
            {
              "component": "LandingHero",
              "rejected": "a page-opening marketing hero, not a listing photo"
            }
          ]
        }
      ]
    },
    {
      "id": "facts",
      "title": "Key facts",
      "heading": false,
      "purpose": "The four numbers buyers check first",
      "layout": {
        "base": "stack"
      },
      "elements": [
        {
          "id": "factRow",
          "component": "InfoStatRow",
          "inputs": {
            "items": [
              {
                "icon": "arrows-right-left",
                "label": "38 m door"
              },
              {
                "icon": "arrows-up-down",
                "label": "11 m height"
              },
              {
                "icon": "square-3-stack-3d",
                "label": "2,900 m²"
              },
              {
                "icon": "sun",
                "label": "Climate"
              }
            ]
          },
          "why": "Icon and short label in one row, scannable at a glance"
        }
      ]
    },
    {
      "id": "about",
      "title": "About",
      "heading": true,
      "purpose": "The seller description, clamped on phones",
      "layout": {
        "base": "stack"
      },
      "elements": [
        {
          "id": "aboutText",
          "component": "ExpandableText",
          "inputs": {
            "lines": 4
          },
          "text": "A climate-controlled hangar on the business aviation side of Dubai World Central, two minutes from the FBO and customs. The 38-metre door and 11-metre clear height take anything up to a Global 7500 or a G700, and the floor is epoxy-sealed with ground power at every bay. Monthly leases include towing, a weekly exterior wash and 24/7 security with access logs; line maintenance from two approved organisations is on call.",
          "why": "Long seller copy clamped to four lines with Read more"
        }
      ]
    },
    {
      "id": "specs",
      "title": "Specification",
      "heading": true,
      "purpose": "Every figure a buyer or broker compares",
      "layout": {
        "base": "stack",
        "md": "grid-2"
      },
      "elements": [
        {
          "id": "specList",
          "component": "DetailList",
          "inputs": {
            "items": [
              {
                "label": "Door width",
                "value": "38 m"
              },
              {
                "label": "Clear height",
                "value": "11 m"
              },
              {
                "label": "Floor area",
                "value": "2,900 m²"
              },
              {
                "label": "Largest aircraft",
                "value": "Global 7500, G700"
              },
              {
                "label": "Ground power",
                "value": "400 Hz at every bay"
              },
              {
                "label": "Fire protection",
                "value": "Foam deluge, NFPA 409"
              },
              {
                "label": "Access",
                "value": "24/7, logged"
              },
              {
                "label": "Minimum term",
                "value": "1 month"
              }
            ]
          },
          "why": "Label and value rows, the system way to list facts"
        },
        {
          "id": "photo",
          "component": "html",
          "tag": "figure",
          "class": "pg-figure",
          "children": [
            {
              "id": "photoImg",
              "component": "html",
              "tag": "img",
              "class": "pg-photo",
              "src": "assets/photos/aviation/hangar-small.webp",
              "alt": "Inside the hangar: a midsize jet under bright LED lights on a sealed grey floor"
            },
            {
              "id": "photoCaption",
              "component": "html",
              "tag": "figcaption",
              "class": "pg-muted m-footnote",
              "text": "Bay 2, with a midsize jet for scale"
            }
          ]
        }
      ]
    },
    {
      "id": "amenities",
      "title": "On board",
      "heading": true,
      "purpose": "What comes with it",
      "layout": {
        "base": "stack"
      },
      "elements": [
        {
          "id": "amenityList",
          "component": "AmenityList",
          "inputs": {
            "items": [
              {
                "icon": "sun",
