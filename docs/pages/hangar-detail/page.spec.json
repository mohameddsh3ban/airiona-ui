{
  "page": "hangar-detail",
  "title": "Hangar",
  "route": "hangar-detail",
  "target": "angular",
  "source": {
    "kind": "brief",
    "ref": "product brief: Airiona aircraft and hangar marketplaces",
    "notes": "The detail page behind one hangar listing card: photo, key facts, description, specification, amenities and a contact form that stays in reach on phones."
  },
  "audience": "An owner or flight department manager checking whether one hangar fits their aircraft and dates, usually on a phone.",
  "primaryAction": "Request hangar space",
  "types": {},
  "data": [],
  "sections": [
    {
